# ── Firebase (client config) ─────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── AI Keys (server-only, never exposed to browser) ───────────────
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
OPENROUTER_MODEL=anthropic/claude-opus-4.8-fast

OPENROUTER_GEMINI_KEY=sk-or-v1-your_gemini_key
OPENROUTER_GEMINI_MODEL=google/gemini-3.1-pro-preview

# ── Blockchain (CyberShield AI — Member 3) ───────────────────────
# Start local node: cd CyberShield-Blockchain && npx hardhat node
# Deploy contract:  npx hardhat run scripts/deploy.js --network localhost
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=your_deployed_contract_address
# Local dev only — Hardhat account #0. NEVER use on mainnet.
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_NETWORK=hardhat
